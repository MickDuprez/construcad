# Config that is not checked into git. See resources/config.edn for the rest.
# `clj -M:dev dev` creates config.env from this file on first run.

DOMAIN=example.com

XTDB_TOPOLOGY=standalone

NREPL_PORT=7888

## Autogenerated. Create new secrets with `clj -M:dev generate-secrets`

# Used to encrypt session cookies.
COOKIE_SECRET={{ new-secret 16 }}
# Used to sign JWTs.
JWT_SECRET={{ new-secret 32 }}
